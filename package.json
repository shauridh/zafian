{
  "name": "saas-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:domain": "bun run scripts/domain-check.ts",
    "check:runtime": "bun run scripts/runtime-check.tsx",
    "check:ui": "bun run scripts/ui-check.ts",
    "check:storage": "bun run scripts/storage-check.ts",
    "check:sync": "bun run scripts/sync-check.ts",
    "check:pull": "bun run scripts/pull-check.ts",
    "check:db": "bun run scripts/db-check.ts",
    "check:cloud": "bun run scripts/cloud-check.ts",
    "sync:export": "bun run scripts/supabase-export.ts",
    "db:seed": "bun run scripts/supabase-seed.ts",
    "supabase:hosted": "bash scripts/supabase-hosted.sh",
    "supabase:verify": "bash scripts/supabase-hosted.sh --verify-only",
    "supabase:production": "bash scripts/supabase-production.sh",
    "supabase:production:verify": "bash scripts/supabase-production.sh --verify-only"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.0",
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "wrangler": "^4.151.0"
  }
}
