# =============================================================================
# Sabana POS — template environment
# =============================================================================
# File ini hanya template. Aplikasi TIDAK membaca file ini, dan Vercel TIDAK
# membaca file ini. Jangan menaruh nilai rahasia di file yang di-commit.
#
# VERCEL (Production + Preview)
# -----------------------------
# Tidak ada environment variable yang wajib. Tiga variabel berikut OPSIONAL:
# hanya untuk mem-prefill form Backup cloud saat aplikasi dibuka.
#
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_OUTLET_ID=
#
# Nilai di atas masuk ke bundle publik (anon/publishable key memang publik).
# Env hanya mem-prefill form. Setelah aktivasi pertama, sesi pemilik disimpan di
# perangkat dan aplikasi menyambung otomatis tanpa membuka pengaturan.
# JANGAN menaruh password owner, frasa sandi enkripsi, service role key, atau
# SUPABASE_ACCESS_TOKEN di Vercel.
#
# Contoh production:
#   VITE_SUPABASE_URL=https://lwirpcrggtsxcooqlriz.supabase.co
#   VITE_OUTLET_ID=cbddce27-79ad-4d1c-9964-9364c806161a
#   VITE_SUPABASE_ANON_KEY=ambil dari Supabase Dashboard → Project Settings → API
#
# Form Backup cloud tetap meminta email, kata sandi owner, dan frasa sandi
# enkripsi. Nilai yang sudah tersimpan di perangkat selalu menang atas env.
#
# NILAI PRODUCTION UNTUK FORM BACKUP CLOUD (bukan env Vercel)
# -----------------------------------------------------------
# Project URL : https://lwirpcrggtsxcooqlriz.supabase.co
# Outlet ID   : cbddce27-79ad-4d1c-9964-9364c806161a
# Anon key    : Supabase Dashboard → Project Settings → API
#               Gunakan anon/publishable key; JANGAN service_role.
# Email       : email owner
# Password    : reset dulu di Authentication → Users
# Passphrase  : frasa sandi enkripsi minimal 8 karakter
#
# -----------------------------------------------------------------------------
# Variabel LOKAL untuk wizard/CLI Supabase (isi di .env.local, gitignored).
# Jangan dimasukkan ke Vercel.
# -----------------------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_OUTLET_ID=
# SUPABASE_OWNER_EMAIL=
#
# -----------------------------------------------------------------------------
# Variabel LOKAL untuk check:ui (opsional).
# -----------------------------------------------------------------------------
# UI_BASE_URL=
# UI_CHECK_SCREENSHOTS=0
