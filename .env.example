# Sabana POS — environment variable mode online (Supabase).
#
# Isi nilai asli di dashboard Vercel (Production + Preview) untuk project ini.
# Vite menanamkan nilai saat BUILD, jadi setiap perubahan env wajib redeploy.
# Jangan menaruh nilai asli di file yang di-commit.
#
# Tanpa dua variabel ini aplikasi berjalan dalam mode lokal (demo) — dipakai
# untuk pengembangan dan check:ui, bukan untuk produksi.
#
# Outlet tidak diatur lewat env: aplikasi memakai outlet dari akun pemilik yang
# login (tabel staff) dan membuatnya otomatis pada login pertama.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Jangan pernah memakai service_role key, kata sandi database, atau password
# pemilik di aplikasi klien — anon key aman karena Supabase RLS membatasi akses.
